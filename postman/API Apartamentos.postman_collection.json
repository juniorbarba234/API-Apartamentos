        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombres\": \"Luis\",\n  \"apellidos\": \"Prueba\",\n  \"email\": \"propietario.{{runId}}@example.com\",\n  \"password\": \"DemoApartamentos2026!\",\n  \"tipo\": \"PROPIETARIO\",\n  \"telefono\": \"5550000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code < 300) pm.collectionVariables.set(\"propietarioId\", pm.response.json().id);",
              "pm.test(\"Contraseña oculta\", () => pm.expect(pm.response.json()).not.to.have.property(\"password\"));"
